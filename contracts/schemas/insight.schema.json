{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnipitch.local/contracts/insight.schema.json",
  "title": "insight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "match_id",
    "moment_id",
    "headline",
    "casual_text",
    "analyst_text",
    "language",
    "evidence_ids",
    "metrics",
    "limitations",
    "generation_mode"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "match_id": {
      "type": "string",
      "minLength": 1
    },
    "moment_id": {
      "type": "string",
      "minLength": 1
    },
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "casual_text": {
      "type": "string",
      "minLength": 1
    },
    "analyst_text": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "enum": [
        "en"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generation_mode": {
      "enum": [
        "fixture",
        "ai",
        "fallback"
      ]
    },
    "knowledge_source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generation_status": {
      "description": "How this text was produced. ai_accepted: model output that passed validation. rule_based: template by design (AI narration off). pending: template while AI narration is on but has not run. skipped: AI not attempted because of budget or configuration. rejected: model output failed validation. provider_failure: the model service failed or timed out. fixture: hand-authored.",
      "enum": [
        "ai_accepted",
        "rule_based",
        "pending",
        "skipped",
        "rejected",
        "provider_failure",
        "fixture",
        null
      ]
    },
    "generation_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "translations": {
      "description": "Other-language versions of this insight. es: the server's Spanish, either a validated AI translation (generation_status ai_accepted) or the rule-based Spanish story.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "es": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headline",
            "casual_text",
            "analyst_text",
            "generation_status"
          ],
          "properties": {
            "headline": {
              "type": "string",
              "minLength": 1
            },
            "casual_text": {
              "type": "string",
              "minLength": 1
            },
            "analyst_text": {
              "type": "string",
              "minLength": 1
            },
            "generation_status": {
              "enum": [
                "ai_accepted",
                "rule_based",
                "pending",
                "skipped",
                "rejected",
                "provider_failure",
                "fixture"
              ]
            },
            "generation_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
