{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnipitch.local/contracts/moment.schema.json",
  "title": "moment",
  "description": "Detected moment with evidence frozen at detection time and its validated insight.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "moment_id",
    "run_id",
    "match_id",
    "rule",
    "rule_version",
    "metric_version",
    "priority",
    "team_id",
    "player_id",
    "period",
    "match_time_ms",
    "anchor_sequence",
    "source_sequence",
    "replay_ms",
    "evidence_ids",
    "metrics",
    "facts",
    "limitations",
    "insight"
  ],
  "properties": {
    "moment_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "match_id": {
      "type": "string",
      "minLength": 1
    },
    "rule": {
      "enum": [
        "goal",
        "chance",
        "threat_gain",
        "transition",
        "pressing_change"
      ]
    },
    "rule_version": {
      "type": "string"
    },
    "metric_version": {
      "type": "string"
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "team_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "player_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "period": {
      "enum": [
        1,
        2
      ]
    },
    "match_time_ms": {
      "type": "integer",
      "minimum": 0
    },
    "anchor_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "source_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "replay_ms": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "facts": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "insight": {
      "$ref": "insight.schema.json"
    }
  }
}
