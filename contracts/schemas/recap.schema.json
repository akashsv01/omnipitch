{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnipitch.local/contracts/recap.schema.json",
  "title": "recap",
  "description": "Halftime or full-time recap built from verified moments and recorded events. Every substantive claim cites moment IDs in sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "match_id",
    "scope",
    "status",
    "through_sequence",
    "clock",
    "score",
    "headline",
    "summary",
    "key_moments",
    "tactical_trend",
    "player_focus",
    "sources",
    "generation_mode",
    "limitations",
    "recap_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "match_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "first_half",
        "full_time"
      ]
    },
    "status": {
      "enum": [
        "provisional",
        "final"
      ]
    },
    "through_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "clock": {
      "type": "string"
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "home",
        "away"
      ],
      "properties": {
        "home": {
          "type": "integer",
          "minimum": 0
        },
        "away": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "key_moments": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moment_id",
          "rule",
          "clock",
          "team_id",
          "headline",
          "generation_mode",
          "source_sequence",
          "replay_ms"
        ],
        "properties": {
          "moment_id": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "enum": [
              "goal",
              "chance",
              "threat_gain",
              "transition",
              "pressing_change"
            ]
          },
          "clock": {
            "type": "string"
          },
          "team_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "headline": {
            "type": "string",
            "minLength": 1
          },
          "generation_mode": {
            "enum": [
              "fixture",
              "ai",
              "fallback"
            ]
          },
          "source_sequence": {
            "type": "integer",
            "minimum": 1
          },
          "replay_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "tactical_trend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported",
        "metric",
        "text",
        "values"
      ],
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "metric": {
          "enum": [
            "ppda",
            null
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "player_focus": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "player_id",
            "name",
            "team_id",
            "text",
            "metrics"
          ],
          "properties": {
            "player_id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "team_id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "metrics": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "value",
                  "unit"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generation_mode": {
      "enum": [
        "ai",
        "fallback"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recap_version": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "en",
        "es"
      ],
      "description": "Language of the recap text. Names, scores and units are not translated."
    },
    "stats": {
      "description": "Team numbers at the recap's cutoff, for comparable rows.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "home",
        "away"
      ],
      "properties": {
        "home": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "goals",
            "shots",
            "shots_on_target",
            "box_entries",
            "final_third_entries",
            "progression_m",
            "completion_pct",
            "pass_share_pct",
            "turnovers_won"
          ],
          "properties": {
            "goals": {
              "type": [
                "number",
                "null"
              ]
            },
            "shots": {
              "type": [
                "number",
                "null"
              ]
            },
            "shots_on_target": {
              "type": [
                "number",
                "null"
              ]
            },
            "box_entries": {
              "type": [
                "number",
                "null"
              ]
            },
            "final_third_entries": {
              "type": [
                "number",
                "null"
              ]
            },
            "progression_m": {
              "type": [
                "number",
                "null"
              ]
            },
            "completion_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "pass_share_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "turnovers_won": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "away": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "goals",
            "shots",
            "shots_on_target",
            "box_entries",
            "final_third_entries",
            "progression_m",
            "completion_pct",
            "pass_share_pct",
            "turnovers_won"
          ],
          "properties": {
            "goals": {
              "type": [
                "number",
                "null"
              ]
            },
            "shots": {
              "type": [
                "number",
                "null"
              ]
            },
            "shots_on_target": {
              "type": [
                "number",
                "null"
              ]
            },
            "box_entries": {
              "type": [
                "number",
                "null"
              ]
            },
            "final_third_entries": {
              "type": [
                "number",
                "null"
              ]
            },
            "progression_m": {
              "type": [
                "number",
                "null"
              ]
            },
            "completion_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "pass_share_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "turnovers_won": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      }
    },
    "story": {
      "description": "What the recap is built around, from the recap's own events: goals with the score after each, whether the leader came from behind, the deciding goal, and shots per half (full time only).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "goals",
        "leader",
        "came_from_behind",
        "decisive_goal",
        "shots_by_half"
      ],
      "properties": {
        "goals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "team_id",
              "player_id",
              "period",
              "clock",
              "sequence",
              "score"
            ],
            "properties": {
              "team_id": {
                "type": "string"
              },
              "player_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "period": {
                "type": "integer"
              },
              "clock": {
                "type": "string"
              },
              "sequence": {
                "type": "integer"
              },
              "score": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "home",
                  "away"
                ],
                "properties": {
                  "home": {
                    "type": "integer"
                  },
                  "away": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "leader": {
          "type": [
            "string",
            "null"
          ]
        },
        "came_from_behind": {
          "type": "boolean"
        },
        "decisive_goal": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "team_id",
                "player_id",
                "period",
                "clock",
                "sequence",
                "score"
              ],
              "properties": {
                "team_id": {
                  "type": "string"
                },
                "player_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "period": {
                  "type": "integer"
                },
                "clock": {
                  "type": "string"
                },
                "sequence": {
                  "type": "integer"
                },
                "score": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "home",
                    "away"
                  ],
                  "properties": {
                    "home": {
                      "type": "integer"
                    },
                    "away": {
                      "type": "integer"
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "shots_by_half": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "first",
                "second"
              ],
              "properties": {
                "first": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "home",
                    "away"
                  ],
                  "properties": {
                    "home": {
                      "type": "integer"
                    },
                    "away": {
                      "type": "integer"
                    }
                  }
                },
                "second": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "home",
                    "away"
                  ],
                  "properties": {
                    "home": {
                      "type": "integer"
                    },
                    "away": {
                      "type": "integer"
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
