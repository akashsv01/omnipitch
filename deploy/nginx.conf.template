# Rendered by the nginx image's envsubst at start (API_UPSTREAM). Logs carry no query strings.
log_format omnipitch '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent $request_time';

server {
    listen 8080;
    server_name _;
    access_log /dev/stdout omnipitch;
    root /usr/share/nginx/html;

    # Same-origin API: the browser never calls the API host directly.
    location ~ ^/(api/|health$|ready$) {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
