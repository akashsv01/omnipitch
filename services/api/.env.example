# Copy to services/api/.env (gitignored) or set as shell variables. Shell variables win.
# No secrets belong here: Event Hubs and Eventhouse use Azure Identity (your `az login` session
# locally, a managed identity when deployed). Never put connection strings or keys in this file.

# Explicit localhost origins for the browser app, comma-separated.
CORS_ORIGINS=http://localhost:5173

# local = simulator/upload + SQLite only. azure = analytics read from Fabric Eventhouse;
# local generate/upload are refused and Eventhouse failures are reported, never replaced by local data.
OMNIPITCH_BACKEND_MODE=local

# Optional SQLite location for replay state, ledger and moments (default data/generated/omnipitch.sqlite3).
# OMNIPITCH_DB_PATH=

# Optional: pin the tenant for each service when your CLI is signed in to more than one
# (for example, Event Hubs in your own tenant and the Fabric workspace in a teammate's tenant as a guest).
# EVENTHUB_TENANT_ID=<tenant-id-or-domain-that-owns-the-namespace>
# EVENTHOUSE_TENANT_ID=<tenant-id-or-domain-that-owns-the-fabric-workspace>

# Event Hubs (publisher). Host name only, not a connection string. Identity needs "Azure Event Hubs Data Sender".
EVENTHUB_FULLY_QUALIFIED_NAMESPACE=<namespace>.servicebus.windows.net
EVENTHUB_NAME=<event-hub-name>

# Fabric Eventhouse (API reader). Query URI from the KQL database page ("Copy URI" > Query URI).
# Identity needs at least Viewer on the Fabric workspace (or the KQL database).
EVENTHOUSE_QUERY_URI=https://<eventhouse-id>.<region>.kusto.fabric.microsoft.com
EVENTHOUSE_DATABASE=<kql-database-name>
EVENTHOUSE_TABLE=OmniPitchEvents

# Narration worker (Phase 3). Azure OpenAI / Foundry chat deployment, Entra ID only (no API keys).
# Identity needs "Cognitive Services OpenAI User" on the resource. Unset = explicit fallback-only mode.
# AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<deployment-name>
# AZURE_OPENAI_API_VERSION=2024-10-21

# Bridge worker (services/bridge). Cosmos DB endpoint only; auth is Entra ID (Cosmos DB data-plane role).
# A teammate in another tenant may set COSMOS_KEY as a shell/.env variable on their own machine; never commit it.
# OMNIPITCH_BRIDGE_STORE=cosmos
# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# COSMOS_DATABASE=omnipitch
# The narration worker (services/agents/run_narrator.py --store cosmos) uses the same COSMOS_* settings and the insights container.

# Phase 4. cosmos = show the narration worker's insights for the replay's source run (uploaded file's run ID or
# Eventhouse run), each re-validated in the API before display; off (default) = deterministic templates only.
# Also enables read-only period reconciliation status in recaps (the bridge's `reconciliations` container).
# OMNIPITCH_INSIGHTS=off
# on = rewrite final halftime/full-time recaps with the AZURE_OPENAI_* deployment, checked in code; off (default).
# OMNIPITCH_RECAP_AI=off
